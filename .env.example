# fair-index-benchmarks — local configuration template.
#
# Copy this file to ".env" and edit the values for your machine:
#     cp .env.example .env
#
# The run scripts load ".env" automatically. ".env" is git-ignored, so your
# local paths and credentials are never committed. Quote any value that
# contains spaces.

# --- Tool locations (absolute paths, no trailing slash) ---
# Local Green Metrics Tool install (the folder that contains runner.py).
GMT_ROOT="/path/to/green-metrics-tool"
# The web-server benchmarking framework (contains tools/measure_docker.py).
FRAMEWORK_ROOT="/path/to/web-server-benchmarks"

# --- Container images ---
# Registry namespace the images are pushed to and pulled from.
GHCR_USER="your-github-user"
REGISTRY="ghcr.io"
TAG="v1"

# --- Load parameters (optional; built-in defaults are sensible) ---
WORKERS="100"
PORT="8001"

# --- Local GMT database (only needed to read results with psql) ---
# Find the password in your GMT install's config.yml (postgres section).
GMT_DB_PASSWORD=""
GMT_DB_PORT="9573"
GMT_DB_NAME="green-coding"
GMT_DB_CONTAINER="green-coding-postgres-container"
